{%- comment -%}
  Shared full-bleed hero banner, controlled by the page's `banner:` front matter.
  Used by the local _layouts/about.liquid and _layouts/page.liquid overrides.
  Renders nothing unless `banner.image` is set.
{%- endcomment -%}
{%- if page.banner and page.banner.image -%}
  {%- assign banner_image = page.banner.image | relative_url -%}
  {%- assign banner_border_color = page.banner.border_color | default: '#e74c3c' -%}
  {%- assign banner_overlay = page.banner.overlay | default: 0.4 -%}
  {%- assign banner_position = page.banner.position | default: 'center top' -%}
  <div class="about-banner{% if page.banner.border %} about-banner--bordered{% endif %}"
       style="background-image: url('{{ banner_image }}'); background-position: {{ banner_position }}; --banner-scrim: rgba(0, 0, 0, {{ banner_overlay }});{% if page.banner.border %} border-color: {{ banner_border_color }};{% endif %}">
    {%- if page.banner.title -%}
      <div class="about-banner__overlay">
        <h1 class="about-banner__title" style="color: {{ page.banner.title_color | default: '#fff' }};">{{ page.banner.title }}</h1>
        {%- if page.banner.tagline -%}
          <p class="about-banner__tagline">{{ page.banner.tagline }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <style>
    .about-banner {
      /* break out of the centered `.container` to full viewport width */
      position: relative;
      left: 50%;
      right: 50%;
      width: 100vw;
      margin-left: -50vw;
      margin-right: -50vw;
      margin-top: -3rem; /* tuck right under the fixed navbar (cancels .container mt-5) */
      margin-bottom: 2.5rem;
      /* Match the compact 240px desktop hero used by limigwenshao.github.io. */
      height: 240px;
      background-size: cover;
      background-position: center top; /* can be overridden per page via banner.position */
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    /* Dark scrim over the photo so the title and image read together
       (à la wang-yuke.com). Tune via `banner.overlay` in front matter. */
    .about-banner::before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--banner-scrim, rgba(0, 0, 0, 0.4));
      pointer-events: none;
    }
    .about-banner--bordered {
      border: 4px solid #e74c3c; /* overridden inline by banner.border_color */
      box-sizing: border-box;
    }
    .about-banner__overlay {
      position: relative; /* sit above the ::before scrim */
      z-index: 1;
      text-align: center;
      color: #fff;
      padding: 1rem 2rem;
      text-shadow:
        0 1px 2px rgba(0, 0, 0, 0.55),
        0 2px 16px rgba(0, 0, 0, 0.7);
    }
    .about-banner__title {
      margin: 0;
      font-size: 3.2rem;
      font-weight: 500;
      color: #fff;
    }
    .about-banner__tagline {
      margin: 0.5rem 0 0;
      font-size: 1.2rem;
    }
    @media (max-width: 768px) {
      .about-banner { height: 200px; }
      .about-banner__title { font-size: 2rem; }
    }
  </style>
{%- endif -%}
