{%- comment -%}
  Local bibliography hook (auto-included by al_folio_core's _layouts/bib.liquid).
  Renders custom BibTeX fields as highlighted tags:
    - `rank`  -> red tag   (e.g. CCF-A)
    - `honor` -> gold tag  (e.g. 🏆 Best Student Paper Award Finalist)
{%- endcomment -%}
{%- if entry.rank -%}
  <span class="pub-rank pub-rank--venue">{{ entry.rank }}</span>
{%- endif -%}
{%- if entry.honor -%}
  <span class="pub-honor pub-honor--venue">{{ entry.honor }}</span>
{%- endif -%}
